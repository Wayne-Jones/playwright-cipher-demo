{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "options": {
    "typeAware": true,
    "typeCheck": true
  },
  "jsPlugins": ["eslint-plugin-playwright"],
  "overrides": [
    {
      "files": ["tests/**", "scripts/**"],
      "rules": {
        "react/rules-of-hooks": "off"
      }
    }
  ]
}
